# systemd user service (Linux). Install:
#   mkdir -p ~/.config/systemd/user
#   cp cycler-stats-pull.service cycler-stats-pull.timer ~/.config/systemd/user/
#   # edit the path below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now cycler-stats-pull.timer
#   sudo loginctl enable-linger "$USER"     # run even when you're not logged in
#   journalctl --user -u cycler-stats-pull   # logs
[Unit]
Description=Pull Cycler stats from Cloudflare D1 into SQLite
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/me/cycler/stats-server/exporter/pull.sh
TimeoutStartSec=15min

# Copy to exporter/.env (never commit .env) and fill in.
# Leave both empty to use an existing `npx wrangler login` on this machine instead.
#
# Token: Cloudflare dashboard -> My Profile -> API Tokens -> Create Token -> Custom token
#   Permissions:       Account | D1 | Edit
#   Account Resources: Include | <your account>
# (D1 Edit is what the D1 export call needs; the same token also works for
#  scripts/delete-install.sh. It cannot touch Workers, DNS or anything else.)
CLOUDFLARE_API_TOKEN=
# Dashboard -> Workers & Pages -> Account ID (right-hand side), or `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=
